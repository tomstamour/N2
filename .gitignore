# --- Ignore everything by default ---
*

# --- but still descend into subdirectories so the allow-rules below can match ---
!*/

# --- track source / config / doc files anywhere in the tree ---
!*.py
!*.sh
!*.txt
!*.md
!.gitignore

# --- ingnore config file with credentials
config/n2_config_file.txt

# --- re-ignore large generated-data folders (they hold big .txt/.csv/.json dumps) ---
trade_mole_outputs/
mole-outputs/
outputs/
outputs_*/
model_trained_on_*/
S4_model_trained_on_*/
ibkr_data/
tables/
# Orchestrator5.4 bench runs (scratch TSVs/logs/stdout.txt/candidate rules per run)
orchestrator5/bench/runs/
# generated run logs — the *.txt ones can leak IBKR account IDs (e.g. preTrade_log.txt)
logs/
# regenerated FinBERT ONNX model (rebuild with setup.sh / FinBERT-*.py --export)
finbert_onnx/
# regenerated FinBERT ONNX feature-extraction model (rebuild with finbert_embed_core.py --export)
finbert_feat_onnx/
# model-3 INT8 FinBERT embedders (rebuild with training_data/model-3/m3_int8_embedder.py)
embedder_int8_*/

# --- but DO track the .tsv outputs in price_stats_loader/outputs/ ---
# (re-include the folder first, since a file can't be un-ignored while its parent dir is)
!price_stats_loader/outputs/
!price_stats_loader/outputs/*.tsv

# --- and DO track the .tsv tables in orchestrator3/tables/ ---
!orchestrator3/tables/
!orchestrator3/tables/*.tsv

# --- DO track only the filtered daily universe .tsv (stocks_universe_YYYY-MM-DD.tsv, no suffix variants) ---
!universe_finder/data/
!universe_finder/data/stocks_universe_[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].tsv

# --- always-ignore noise ---
__pycache__/
*.pyc
.env
venv/
.venv/
env/
ENV/
node_modules/
.DS_Store
*.log

# --- keep this local-only helper file out of the repo ---
/git-workflow.txt
/RTPR_connector3/RTPR_connector3_Firehose.py
